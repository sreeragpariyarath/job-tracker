# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/job-tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/job-tracker?retryWrites=true&w=majority

# Optional: MongoDB Database name (defaults to "job-tracker" if omitted)
MONGODB_DB=job-tracker

# Optional: API key from OpenWeb Ninja for JSearch. FreeHire needs no key.
JSEARCH_API_KEY=
# Random secret for authenticating Vercel's scheduled job.
CRON_SECRET=

# Auth0 Regular Web Application credentials (not Google OAuth credentials)
AUTH0_DOMAIN=job-trackers.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH0_SECRET=
# Exact origin, without trailing slash
APP_BASE_URL=http://localhost:3000
# Copy the exact Sub from your successful Auth0 Google connection test
AUTH0_OWNER_SUB=
